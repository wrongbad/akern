#!/bin/sh
case "$1" in --help) echo 'usage: akern ["prompt text"] — start with the prompt, then send each line typed; Ctrl-D ends'; exit 0 ;; esac
render="${AKERN_HOME:-$HOME/.akern}/render.jq"
prompted=false
[ $# -gt 0 ] && set -- -- "$*" && prompted=true
trap '' INT
akern-loop "$@" | "$render" --arg prompted $prompted
