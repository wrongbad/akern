#!/bin/sh
case "$1" in --help) echo 'usage: akern ["prompt text"] — start with the prompt, then send each line typed; Ctrl-D ends'; exit 0 ;; esac
home="${AKERN_HOME:-$HOME/.akern}"
: "${AKERN_MODEL:=$(sed -n 1p "$home/model" 2>/dev/null)}"
[ -n "$AKERN_MODEL" ] || AKERN_MODEL=$(akern-model) || exit
export AKERN_MODEL
prompted=false
[ $# -gt 0 ] && set -- -- "$*" && prompted=true
trap '' INT
akern-loop "$@" | "$home/render.jq" --arg prompted $prompted
