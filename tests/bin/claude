#!/usr/bin/env python3
"""Stands in for the claude CLI: acknowledges each queued message as claude does, records its arguments, stdin and
environment in $FAKE_CLAUDE_LOG, then prints $FAKE_CLAUDE_REPLY."""
import json
import os
import sys

lines = []
for line in sys.stdin:
    lines.append(json.loads(line))
    if lines[-1].get("shouldQuery") is False:
        print(json.dumps({"type": "result", "subtype": "success", "num_turns": 0, "is_error": False}), flush=True)
with open(os.environ["FAKE_CLAUDE_LOG"], "w") as log:
    json.dump({"argv": sys.argv[1:], "stdin": lines, "env": dict(os.environ)}, log)
with open(os.environ["FAKE_CLAUDE_REPLY"]) as reply:
    sys.stdout.write(reply.read())
